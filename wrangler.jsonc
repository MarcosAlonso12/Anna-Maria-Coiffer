{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anna-maria-coiffer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anna-maria-db",
      "migrations_dir": "drizzle",
      "database_id": "2a77c932-d3a9-49d7-b44e-e27baea6022d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "anna-maria-arquivos"
    }
  ]
}
